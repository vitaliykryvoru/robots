<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="inertial_box"

params="mass x y z">

<inertial>

<mass value="${mass}"/>

<origin xyz="0 0 0"/>

<inertia

ixx="${mass*(y*y+z*z)/12}"

iyy="${mass*(x*x+z*z)/12}"

izz="${mass*(x*x+y*y)/12}"

ixy="0"

ixz="0"

iyz="0"/>

</inertial>

</xacro:macro>



<xacro:macro

name="inertial_cylinder"

params="mass radius length">

<inertial>

<mass value="${mass}"/>

<origin xyz="0 0 0"/>

<inertia

ixx="${mass*(3*radius*radius+length*length)/12}"

iyy="${mass*(3*radius*radius+length*length)/12}"

izz="${0.5*mass*radius*radius}"

ixy="0"

ixz="0"

iyz="0"/>

</inertial>

</xacro:macro>

</robot>
