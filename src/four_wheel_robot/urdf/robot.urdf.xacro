<?xml version="1.0"?>

<robot name="four_wheel_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

       
    <xacro:include filename="inertial_macros.xacro"/>

    <!-- Розміри корпуса -->

    <xacro:property name="body_length" value="0.25"/>
    <xacro:property name="body_width" value="0.15"/>
    <xacro:property name="body_height" value="0.12"/>

    <!-- Розміри коліс -->

    <xacro:property name="wheel_radius" value="0.03"/>
    <xacro:property name="wheel_width" value="0.02"/>

    <!-- Відступи коліс -->

    <xacro:property name="wheel_x" value="0.07"/>
    <xacro:property name="wheel_y" value="0.09"/>



    <!-- Матеріали -->

    <material name="orange">
        <color rgba="1 0.4 0 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>



    <!-- BASE -->

    <link name="base_link"/>



    <!-- CHASSIS -->

    <joint name="chassis_joint" type="fixed">

        <parent link="base_link"/>

        <child link="chassis"/>

        <origin xyz="0 0 0.08"/>

    </joint>



    <link name="chassis">

        <visual>

        <geometry>

        <box size="${body_length}

        ${body_width}

        ${body_height}"/>

        </geometry>

        <material name="orange"/>

        </visual>



        <collision>

        <geometry>

        <box size="${body_length}

        ${body_width}

        ${body_height}"/>

        </geometry>

        </collision>



        <xacro:inertial_box

        mass="2.0"

        x="${body_length}"

        y="${body_width}"

        z="${body_height}"/>

    </link>





    <!-- FRONT LEFT -->

    <joint name="front_left_joint"

           type="continuous">

        <parent link="base_link"/>

        <child link="front_left_wheel"/>

        <origin xyz="${wheel_x}
                      ${wheel_y}
                      0.03"

                rpy="-1.5708 0 0"/>

        <axis xyz="0 0 1"/>

    </joint>



    <link name="front_left_wheel">

        <visual>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        <material name="blue"/>

        </visual>



        <collision>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        </collision>



        <xacro:inertial_cylinder

        mass="0.2"

        radius="${wheel_radius}"

        length="${wheel_width}"/>

    </link>

    <!-- FRONT RIGHT -->

    <joint name="front_right_joint"

           type="continuous">

        <parent link="base_link"/>

        <child link="front_right_wheel"/>

        <origin xyz="${wheel_x}
                     -${wheel_y}
                      0.03"

                rpy="1.5708 0 0"/>

        <axis xyz="0 0 -1"/>

    </joint>



    <link name="front_right_wheel">

        <visual>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        <material name="blue"/>

        </visual>



        <collision>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        </collision>



        <xacro:inertial_cylinder

        mass="0.2"

        radius="${wheel_radius}"

        length="${wheel_width}"/>

    </link>





    <!-- REAR LEFT -->

    <joint name="rear_left_joint"

           type="continuous">

        <parent link="base_link"/>

        <child link="rear_left_wheel"/>

        <origin xyz="-${wheel_x}
                      ${wheel_y}
                      0.03"

                rpy="-1.5708 0 0"/>

        <axis xyz="0 0 1"/>

    </joint>



    <link name="rear_left_wheel">

        <visual>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        <material name="blue"/>

        </visual>



        <collision>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        </collision>



        <xacro:inertial_cylinder

        mass="0.2"

        radius="${wheel_radius}"

        length="${wheel_width}"/>

    </link>





    <!-- REAR RIGHT -->

    <joint name="rear_right_joint"

           type="continuous">

        <parent link="base_link"/>

        <child link="rear_right_wheel"/>

        <origin xyz="-${wheel_x}
                     -${wheel_y}
                      0.03"

                rpy="1.5708 0 0"/>

        <axis xyz="0 0 -1"/>

    </joint>



    <link name="rear_right_wheel">

        <visual>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        <material name="blue"/>

        </visual>



        <collision>

        <geometry>

        <cylinder

        radius="${wheel_radius}"

        length="${wheel_width}"/>

        </geometry>

        </collision>



        <xacro:inertial_cylinder

        mass="0.2"

        radius="${wheel_radius}"

        length="${wheel_width}"/>

    </link>


    <gazebo reference="chassis">

    <material>

    Gazebo/Orange

    </material>

    </gazebo>



    <gazebo reference="front_left_wheel">

    <material>

    Gazebo/Blue

    </material>

    </gazebo>



    <gazebo reference="front_right_wheel">

    <material>

    Gazebo/Blue

    </material>

    </gazebo>



    <gazebo reference="rear_left_wheel">

    <material>

    Gazebo/Blue

    </material>

    </gazebo>



    <gazebo reference="rear_right_wheel">

    <material>

    Gazebo/Blue

    </material>

    </gazebo>

</robot>